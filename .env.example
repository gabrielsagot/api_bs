# ─────────────────────────────────────────────────────────────
# Brawl Dashboard : configuration locale
# Copie ce fichier en `.env` (cp .env.example .env) puis remplis-le.
# Le fichier .env est ignoré par Git : tes identifiants ne partent jamais sur GitHub.
# ─────────────────────────────────────────────────────────────

# Compte développeur https://developer.brawlstars.com (gestion automatique de la clé API).
# L'app se connecte au portail, crée une clé pour ton IP publique actuelle
# et en recrée une toute seule si ton IP change.
# ⚠ Si ton mot de passe contient #, un espace ou des guillemets, mets-le entre
#   guillemets simples : BS_DEV_PASSWORD='mon#motdepasse'
BS_DEV_EMAIL=
BS_DEV_PASSWORD=

# (Optionnel) Clé API manuelle, utilisée seulement si les identifiants ci-dessus sont vides.
BS_API_KEY=

# (Optionnel) Ton tag joueur, ajouté automatiquement au premier lancement.
# Écris-le SANS le # (dans ce fichier, # démarre un commentaire). Exemple : BS_PLAYER_TAG=2PP
# Plusieurs comptes : sépare-les par des virgules (2PP,8QJR0YC).
# Tu peux aussi tout gérer depuis l'interface (Réglages).
BS_PLAYER_TAG=

# Réseau : 0.0.0.0 rend le dashboard accessible depuis ton téléphone sur le même Wi-Fi.
# Mets 127.0.0.1 pour le réserver à cet ordinateur.
HOST=0.0.0.0
PORT=4777

# Fréquence de collecte en secondes : pendant une session de jeu / au repos.
POLL_ACTIVE_SECONDS=120
POLL_IDLE_SECONDS=600

# ── Réglages avancés (rarement utiles) ──
# Nom donné aux clés créées automatiquement sur le portail développeur.
# BS_KEY_NAME=brawl-dashboard
# Dossier de la base SQLite et du cache d'images.
# DATA_DIR=./data
# URL de base de l'API (ex. un proxy : https://bsproxy.royaleapi.dev/v1).
# BS_API_BASE_URL=https://api.brawlstars.com/v1
